{
	"name": "@nexus-ioc/language-service",
	"version": "0.1.1",
	"description": "TypeScript Language Service Plugin for Nexus IoC - provides IntelliSense, go-to-definition, and diagnostics for dependency injection",
	"author": "Isqanderm <aleksandr.melnik.personal@gmail.com> (https://www.linkedin.com/in/isqander-melnik)",
	"homepage": "https://github.com/Isqanderm/ioc#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Isqanderm/ioc.git"
	},
	"bugs": {
		"url": "https://github.com/Isqanderm/ioc/issues"
	},
	"keywords": [
		"typescript",
		"language-service-plugin",
		"typescript-plugin",
		"IoC",
		"dependency injection",
		"inversion control",
		"DI",
		"intellisense",
		"autocomplete",
		"nexus-ioc",
		"framework",
		"container"
	],
	"files": [
		"dist",
		"package.json",
		"LICENSE",
		"README.md"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.5.4",
		"@vitest/coverage-v8": "^2.1.8",
		"sinon": "^18.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@phenomnomnominal/tsquery": "^6.1.3",
		"tslib": "^2.6.3"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest run",
		"clean": "rm -rf ./dist",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"code:format": "npx @biomejs/biome format --write",
		"code:lint": "npx @biomejs/biome lint --write",
		"code:check": "npx @biomejs/biome check",
		"code:check:ci": "npx @biomejs/biome ci",
		"code:check:apply": "npx @biomejs/biome check --write",
		"test:ready": "echo 0"
	}
}
