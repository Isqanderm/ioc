{
	"compilerOptions": {
		"target": "ES2021",
		"module": "CommonJS",
		"lib": ["ES2021"],
		"sourceMap": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"esModuleInterop": true,

		"composite": true,
		"declaration": true,
		"skipLibCheck": true,
		"importHelpers": true,
		"removeComments": false,
		"noLib": false,
		"allowJs": false,
		"strict": true,
		"types": ["node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
